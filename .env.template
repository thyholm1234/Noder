# ============================================
# Noder - Konfiguration (template)
# Kopiér denne fil til .env og udfyld værdierne
# ============================================

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=skift-mig

# PostgreSQL
POSTGRES_USER=noder
POSTGRES_PASSWORD=skift-mig
POSTGRES_DB=noder_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://noder:skift-mig@db:5432/noder_db

# App
SECRET_KEY=skift-til-en-lang-tilfaeldig-streng
APP_PORT=9372

# Storage quota (understøtter B, K, M, G, T — fx 4G eller 500M)
QUOTA=4G
