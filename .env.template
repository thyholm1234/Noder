# ============================================
# Noder - Konfiguration (template)
# Kopiér denne fil til .env og udfyld værdierne
# ============================================

# Superadmin-login — opretter og administrerer korledere (korlederne ligger i databasen, ikke her).
# Standardværdien "skift-mig" afvises, så vælg din egen (min. 10 tegn).
# OPGRADERING fra en version med én administrator: start først én gang med de GAMLE værdier — så oprettes
# den nuværende korleder automatisk i databasen (samme brugernavn og adgangskode) med alle sine kor og sange.
# Skift derefter disse to linjer til superadminens egne oplysninger og start igen. Korlederen logger
# fortsat ind med sine gamle oplysninger.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=skift-mig

# PostgreSQL
POSTGRES_USER=noder
POSTGRES_PASSWORD=skift-mig
POSTGRES_DB=noder_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://noder:skift-mig@db:5432/noder_db

# App
# Lang tilfældig streng, fx: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=skift-til-en-lang-tilfaeldig-streng
APP_PORT=9372

# Sæt til true når siden serveres over HTTPS (fx bag en reverse proxy)
SESSION_HTTPS_ONLY=false
# Hvor længe man forbliver logget ind
SESSION_MAX_AGE_DAYS=30

# Storage quota (understøtter B, K, M, G, T — fx 4G eller 500M)
QUOTA=4G
# Superadmin kan sætte en lavere kvote pr. korleder under Korledere (aldrig over QUOTA). Uden egen kvote gælder QUOTA.
# Største tilladte enkeltfil ved upload
MAX_UPLOAD=200M
